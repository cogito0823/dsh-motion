{
  "name": "dsh-motion",
  "version": "0.4.0",
  "description": "Code-generated math & science animations for DeepSeek Harness: frames-first preview, Manim clips, formula checks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "skills",
    "styles",
    "docs",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "animation",
    "manim",
    "science",
    "video",
    "code-animation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/ops.js && node --check lib/env.js && node --check lib/doctor.js",
    "test": "node scripts/test-ops.mjs && node scripts/test-route.mjs && node scripts/test-plan.mjs && node scripts/test-approvals.mjs",
    "smoke": "node scripts/smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "route": "node scripts/route-style.mjs",
    "plan": "node scripts/plan-questions.mjs",
    "approvals": "node scripts/approvals.mjs",
    "styles:index": "node scripts/build-style-index.mjs",
    "styles:check": "node scripts/build-style-index.mjs --check",
    "check:meta": "node scripts/check-meta.mjs",
    "prepack": "npm run check && npm test && npm run smoke"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogito0823/dsh-motion.git"
  },
  "homepage": "https://github.com/cogito0823/dsh-motion#readme",
  "bugs": {
    "url": "https://github.com/cogito0823/dsh-motion/issues"
  }
}
