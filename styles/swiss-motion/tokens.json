{
  "name": "swiss-motion",
  "version": "1.0.0",
  "source": "https://github.com/lemomo-ai/lemo-opuscar/tree/main/styles/swiss-motion",
  "license": "style doc MIT; demo stills CC BY 4.0 (LemoLab)",
  "colors": {
    "ground": "#EAE9E5",
    "paper": "#FFFFFF",
    "ink": "#111111",
    "muted": "#6B6B6B",
    "rule": "#C9C7C1",
    "signal": "#E30613"
  },
  "typography": {
    "display": { "family": "Noto Sans", "weight": "BOLD", "size": 64 },
    "body": { "family": "Noto Sans", "size": 26 },
    "mono": { "family": "Menlo", "size": 18 },
    "math": { "family": "New Computer Modern", "size": 96 }
  },
  "layout": {
    "aspect": "16:9",
    "frame": { "width": 14.222, "height": 8.0 },
    "margin": 0.5,
    "columns": 12
  },
  "motion": {
    "fps": 30,
    "easing": "precise",
    "snap_seconds": 0.4,
    "hold_min_seconds": 1.0
  },
  "audio": { "target_lufs": -14, "true_peak_db": -1 }
}
