{
  "name": "whiteboard",
  "version": "1.0.0",
  "source": "https://github.com/lemomo-ai/lemo-opuscar/tree/main/styles/whiteboard",
  "license": "style doc MIT; demo stills CC BY 4.0 (LemoLab)",
  "colors": {
    "board": "#F7F5EF",
    "board_edge": "#E9E4D8",
    "ink": "#23262C",
    "blue": "#2A5CB3",
    "orange": "#D97757",
    "muted": "#8A857C",
    "ghost": "#C9C3B6"
  },
  "typography": {
    "hand": { "family": "Chalkboard SE", "size": 34 },
    "label": { "family": "Chalkboard SE", "size": 24 },
    "math": { "family": "New Computer Modern", "size": 54 }
  },
  "layout": {
    "aspect": "16:9",
    "frame": { "width": 14.222, "height": 8.0 },
    "margin": 0.55
  },
  "motion": { "fps": 30, "easing": "hand-speed", "hold_min_seconds": 1.4 },
  "audio": { "target_lufs": -14, "true_peak_db": -1 }
}
