{
  "name": "dataviz",
  "version": "1.0.0",
  "source": "https://github.com/lemomo-ai/lemo-opuscar/tree/main/styles/dataviz",
  "license": "style doc MIT; demo stills CC BY 4.0 (LemoLab)",
  "colors": {
    "paper": "#F4EDE1",
    "paper_shadow": "#E8DECF",
    "ink": "#2B2622",
    "grid": "#C9BFAE",
    "muted": "#7A6F63",
    "blue": "#2F5D8A",
    "red": "#B5442E",
    "ramp_low": "#2166AC",
    "ramp_mid": "#F7F7F7",
    "ramp_high": "#B2182B"
  },
  "typography": {
    "display": { "family": "Songti SC", "weight": "BOLD", "size": 42 },
    "body": { "family": "Songti SC", "size": 24 },
    "mono": { "family": "Menlo", "size": 18 },
    "math": { "family": "New Computer Modern", "size": 56 }
  },
  "layout": {
    "aspect": "16:9",
    "frame": { "width": 14.222, "height": 8.0 },
    "margin": 0.55
  },
  "motion": { "fps": 30, "easing": "chart-operation", "hold_min_seconds": 1.2 },
  "audio": { "target_lufs": -14, "true_peak_db": -1 }
}
